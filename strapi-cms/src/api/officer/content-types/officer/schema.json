  "attributes": {
    "name":       { "type": "string", "required": true },
    "role":       { "type": "string", "required": true },
    "department": { "type": "string" },
    "photo_url":  { "type": "string" },
    "tier": {
      "type": "enumeration",
      "enum": ["inti", "departemen"],
      "default": "inti",
      "required": true
    },
    "sort_order": { "type": "integer", "default": 0 }
  }
}
