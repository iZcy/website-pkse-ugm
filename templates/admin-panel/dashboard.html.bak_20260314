    <div class="p-6 border-b border-slate-200 flex items-center justify-between">
      <h3 id="modalAkunTitle" class="text-lg font-bold">Tambah Akun</h3>
      <button onclick="closeModal('modalAkun')" class="text-slate-400 hover:text-slate-600 p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="formAkun" class="p-6 space-y-4">
      <input type="hidden" id="akun-id">
