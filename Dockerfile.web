# nginx image with all four Vite SPAs baked in, so the production host needs
# neither node nor a /var/www bind mount.
#
# vite.config.ts is the multi-entry build that production actually uses: it
# emits admin/member/rapor/login against a single shared /assets/ directory.
# The per-SPA configs (vite.member.ts etc.) are dev-only and produce a
# different, incompatible asset layout.
FROM node:20-alpine AS build
WORKDIR /ui
COPY admin-ui/package.json admin-ui/package-lock.json ./
RUN npm ci
COPY admin-ui/ ./
RUN npm run build

FROM nginx:alpine
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist/assets/          /var/www/assets/
COPY --from=build /ui/dist/index.html       /var/www/admin-ui/admin/index.html
COPY --from=build /ui/dist/member.html      /var/www/member-ui/member/index.html
COPY --from=build /ui/dist/rapor.html       /var/www/rapor-ui/rapor/index.html
COPY --from=build /ui/dist/login-entry.html /var/www/login-ui/login/index.html
